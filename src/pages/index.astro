---
import Base from '../layouts/Base.astro';
import UniversCard from '../components/UniversCard.astro';
import Metar from '../components/Metar.astro';
import { getCollection } from 'astro:content';
import club from '../data/club.json';
import { univers } from '../data/univers';
import { url, asset } from '../lib/utils';

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const annees = new Date().getFullYear() - 1979;
const slides = [
  { img: '/uploads/avions/dr400-120-01.jpg', legende: 'Aux commandes du DR400' },
  { img: '/uploads/avions/dr400-120-02.jpg', legende: 'Robin DR400 120 ch' },
  { img: '/uploads/avions/dr300-f-btbs-01.jpg', legende: 'Le DR300 F-BTBS devant le hangar' },
  { img: '/uploads/avions/jodel-d120-01.jpg', legende: 'Jodel D120 Paris-Nice' },
];
// Les trois façons de voler avec le club (la flotte, le club et l'espace membre ont leur propre place).
const facons = [
  { ...univers.find((u) => u.id === 'decouvrir')!, image: '/uploads/avions/dr400-120-03.jpg' },
  univers.find((u) => u.id === 'apprendre')!,
  { id: 'voler', titre: 'Piloter au club', sousTitre: 'Déjà breveté ? Rejoignez le club et volez sur nos avions', href: '/club/flotte', image: '/uploads/avions/dr300-f-btbs-03.jpg' },
];
---
<Base title="Accueil">
  <section class="hero" aria-label="Présentation">
    <div class="slides">
      {slides.map((s, i) => <img src={asset(s.img)} alt={s.legende} class:list={{ on: i === 0 }} loading={i ? 'lazy' : 'eager'} />)}
    </div>
    <div class="voile"></div>
    <svg class="vol" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <mask id="trace-mask" maskUnits="userSpaceOnUse"><path id="trace-plein" d="M -60 560 C 220 560, 430 470, 580 330 S 840 70, 1100 30" fill="none" stroke="#fff" stroke-width="6" /></mask>
      </defs>
      <path class="trace" d="M -60 560 C 220 560, 430 470, 580 330 S 840 70, 1100 30" mask="url(#trace-mask)" />
      <g class="avion-svg"><path transform="scale(1.4)" d="M16,0 C16,-1.6 13,-2.4 10,-2.4 L4,-2.4 L2,-19 L-3,-19 L-3,-2.4 L-14,-2 L-17,-8 L-20,-8 L-19,-1.6 L-19,1.6 L-20,8 L-17,8 L-14,2 L-3,2.4 L-3,19 L2,19 L4,2.4 L10,2.4 C13,2.4 16,1.6 16,0 Z" /></g>
    </svg>
    <div class="container hero-inner">
      <div class="texte">
        <span class="eyebrow" data-reveal data-delay="0.1">Aéroport de Beauvais-Tillé</span>
        <h1 data-split="now">Prenez les commandes du ciel picard</h1>
        <p class="lead" data-reveal data-delay="0.8">Depuis {annees} ans, nos instructeurs bénévoles font voler et forment des pilotes à Beauvais-Tillé.</p>
        <div class="btns" data-stagger data-delay="1">
          <a class="btn btn-primary" href={url('/decouvrir-le-vol')}>Faire un baptême</a>
          <a class="btn btn-ghost" href={url('/formations')}>Devenir pilote</a>
        </div>
      </div>
      <div class="hero-bas" data-reveal data-delay="1.3">
        <div class="compteur"><b id="slide-n">01</b> / {String(slides.length).padStart(2, '0')} <span id="slide-l">{slides[0].legende}</span></div>
      </div>
    </div>
  </section>

  <div class="bande-metar"><div class="container"><Metar sombre /></div></div>

  <section class="section" id="univers">
    <div class="container">
      <div class="section-head">
        <div><span class="label">Bienvenue au club</span><h2 data-split>Choisissez votre façon de voler</h2></div>
        <p class="lead" style="max-width:40ch;margin:0" data-reveal data-delay="0.3">Première fois en avion, futur pilote ou déjà breveté : par où voulez-vous commencer ?</p>
      </div>
      <div class="facons" data-stagger>
        {facons.map((u) => <UniversCard u={u} variante="bandeau" />)}
      </div>
    </div>
  </section>

  <div class="marquee" data-marquee aria-hidden="true">
    <div class="piste"><span>Baptêmes <i>✦</i> <em>BIA</em> <i>✦</i> LAPL <i>✦</i> <em>PPL</em> <i>✦</i> Voyages <i>✦</i> <em>Depuis 1979</em> <i>✦</i></span></div>
  </div>

  <section class="section dark histoire">
    <div class="container grid grid-2">
      <div>
        <span class="label">Depuis 1979</span>
        <h2 data-split>Plus de quarante ans d'histoire au bord des pistes</h2>
        <p data-reveal>Du Rallye et du Cessna 150 des débuts au club-house de la zone aéroplaisance, revivez l'histoire de l'ACBT en photos.</p>
        <div class="chiffres" data-stagger>
          <div><strong data-count="1979" data-from="1900">1979</strong><span>fondation</span></div>
          <div><strong data-count={avions.length}>{avions.length}</strong><span>avions</span></div>
          <div><strong data-count="100" data-suffix=" %">100 %</strong><span>bénévoles</span></div>
        </div>
        <a class="btn btn-ghost" href={url('/club/historique')}>Notre histoire</a>
      </div>
      <div class="histoire-img" data-clip><img src={asset('/uploads/historique/1979-debuts-du-club.jpg')} alt="Les débuts de l'aéroclub" loading="lazy" data-parallax="8" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-band">
      <div>
        <span class="label">Nous trouver</span>
        <h2 data-split>Passez nous voir au club</h2>
        <p class="lead" data-reveal>Zone aéroplaisance de l'aéroport de Beauvais-Tillé. Adresse, horaires, plan d'accès et itinéraire : tout est dans les infos pratiques.</p>
        <div class="btns" data-stagger>
          <a class="btn btn-primary" href={url('/club#infos')}>Venir au club</a>
          <a class="btn btn-outline" href={`tel:${club.telephone.replace(/\s/g, '')}`}>{club.telephone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  // Avion qui traverse le ciel du hero en laissant une trace pointillée, puis la parallaxe au défilement.
  if (document.documentElement.classList.contains('motion')) {
    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);
    const mm = gsap.matchMedia();
    mm.add('(min-width: 701px)', () => {
      const plein = document.getElementById('trace-plein') as unknown as SVGPathElement;
      const longueur = plein.getTotalLength();
      gsap.set(plein, { strokeDasharray: longueur, strokeDashoffset: longueur });
      gsap.set('.vol', { autoAlpha: 1 });
      gsap.timeline({ delay: 1.2, repeat: -1, repeatDelay: 7 })
        .set('.trace', { opacity: 1 })
        .set(plein, { strokeDashoffset: longueur })
        .to('.avion-svg', { duration: 7, ease: 'power1.inOut', motionPath: { path: '#trace-plein', align: '#trace-plein', alignOrigin: [0.5, 0.5], autoRotate: true } }, 0)
        .to(plein, { strokeDashoffset: 0, duration: 7, ease: 'power1.inOut' }, 0)
        .to('.trace', { opacity: 0, duration: 2, ease: 'power2.in' }, 7.5);

      const scroll = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
      gsap.to('.slides', { yPercent: 18, ease: 'none', scrollTrigger: scroll });
      gsap.to('.vol', { yPercent: 30, ease: 'none', scrollTrigger: scroll });
      gsap.to('.hero .texte', { y: -90, opacity: 0.15, ease: 'none', scrollTrigger: scroll });
    });
  }

  const imgs = [...document.querySelectorAll<HTMLImageElement>('.slides img')];
  const n = document.getElementById('slide-n');
  const l = document.getElementById('slide-l');
  let i = 0;
  if (imgs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      imgs[i].classList.remove('on');
      i = (i + 1) % imgs.length;
      imgs[i].loading = 'eager';
      imgs[i].classList.add('on');
      if (n) n.textContent = String(i + 1).padStart(2, '0');
      if (l) l.textContent = imgs[i].alt;
    }, 6000);
  }
</script>

<style>
  .hero { position: relative; min-height: min(92vh, 860px); display: flex; color: #fff; background: var(--ink); overflow: hidden; }
  .slides { position: absolute; inset: 0; }
  .slides img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity 1.4s ease, transform 7s ease-out; }
  .slides img.on { opacity: 1; transform: scale(1); }
  .voile { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,18,31,.78) 0%, rgba(10,18,31,.35) 55%, rgba(10,18,31,.1) 100%), linear-gradient(0deg, rgba(10,18,31,.7) 0%, transparent 40%); }
  .vol { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; visibility: hidden; }
  .trace { fill: none; stroke: rgba(255,255,255,.7); stroke-width: 2; stroke-dasharray: 2 12; stroke-linecap: round; }
  .avion-svg path { fill: #fff; filter: drop-shadow(0 6px 10px rgba(0,0,0,.35)); }
  @media (max-width: 700px) { .vol { display: none; } }
  .hero-inner { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(72px, 14vh, 160px) 0 32px; gap: 48px; }
  .hero h1 { color: #fff; max-width: 13ch; }
  .hero .lead { color: rgba(255,255,255,.88); max-width: 46ch; }
  .hero-bas { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.25); padding-top: 20px; }
  /* Mobile : la photo passe au-dessus, le texte sur fond uni pour rester lisible. */
  @media (max-width: 700px) {
    .hero { flex-direction: column; min-height: 0; }
    .slides { position: relative; height: 62vw; max-height: 340px; overflow: hidden; }
    .voile { inset: 0 0 auto 0; height: min(62vw, 340px); background: linear-gradient(180deg, rgba(10,18,31,0) 55%, var(--ink) 100%); }
    .hero-inner { padding: 8px 0 28px; gap: 28px; }
    .hero .lead { color: rgba(255,255,255,.82); }
    .hero .btns .btn { flex: 1 1 auto; justify-content: center; }
  }
  .compteur { font-size: .85rem; letter-spacing: .1em; color: rgba(255,255,255,.75); }
  .compteur b { font-family: var(--font-title); font-size: 1.6rem; color: #fff; letter-spacing: 0; }
  .compteur span { margin-left: 14px; text-transform: none; letter-spacing: 0; }
  .une { display: block; max-width: 380px; padding: 16px 20px; border-radius: 16px; background: rgba(255,255,255,.12); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.22); color: #fff; text-decoration: none; transition: background .2s; }
  .une:hover { background: rgba(255,255,255,.22); color: #fff; }
  .une-label { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: #ffc59e; margin-bottom: 4px; }
  .une strong { font-family: var(--font-title); font-size: 1.1rem; font-weight: 600; }


  .flotte { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .avion { text-decoration: none; color: inherit; }
  .avion img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; border-radius: 18px; transition: transform .4s; }
  .avion:hover img { transform: translateY(-4px); }
  .avion div { padding: 14px 4px 0; display: flex; flex-direction: column; }
  .avion strong { font-family: var(--font-title); font-size: 1.2rem; font-weight: 600; }
  .avion span { color: var(--muted); font-size: .88rem; }


  .histoire .grid { align-items: center; }
  .histoire-img { border-radius: 20px; overflow: hidden; }
  .histoire img { filter: sepia(.15); width: 100%; }
  .chiffres { display: flex; gap: 36px; margin: 28px 0 32px; flex-wrap: wrap; }
  .chiffres strong { display: block; font-family: var(--font-title); font-size: 2.4rem; color: #fff; line-height: 1; }
  .chiffres span { font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; color: #9fb0c6; }
  .facons { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  .facons :global(.carte) { min-height: 0; }
  .facons :global(.carte .img) { aspect-ratio: 3 / 2; flex: none; min-height: 0; }
  @media (max-width: 860px) { .facons { grid-template-columns: 1fr; } .facons :global(.carte) { min-height: 0; } }
  .bande-metar { background: #0a1424; border-top: 1px solid rgba(255,255,255,.08); padding: 12px 0; }
  .contact-band { display: block; }
  .contact-band .btns { margin-top: 20px; }
</style>
