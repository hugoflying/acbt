---
import { photo, photoUrl } from '../lib/photo';
import Base from '../layouts/Base.astro';
import Metar from '../components/Metar.astro';
import { getCollection } from 'astro:content';
import club from '../data/club.json';
import pages from '../data/pages.json';
import t from '../data/tarifs.json';
import f from '../data/formations.json';
import { url, asset } from '../lib/utils';

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const annees = new Date().getFullYear() - 1979;
const pg = pages.accueil;
const slides = pg.diaporama.map((d) => ({ img: d.image, legende: d.legende }));
// Les trois choix sous la photo : textes et photos modifiables dans le back-office (Pages du site > Accueil).
const des = Math.min(...t.formules.flatMap((f) => f.prix.map((p) => p.prix)));
const cibles = [
  { id: 'decouvrir', href: '/decouvrir-le-vol', badge: `dès ${des.toLocaleString('fr-FR')} €`, action: 'Voir les prix' },
  { id: 'apprendre', href: '/formations#simulateur', badge: 'Budget en 1 minute', action: 'Calculer mon budget' },
  { id: 'voler', href: '/club/flotte', badge: '', action: 'Voir les avions' },
];
const choix = pg.cartes.slice(0, 3).map((c, i) => ({ ...cibles[i], titre: c.titre, texte: c.texte, image: c.image }));
---
<Base title="Accueil">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SportsClub', name: club.nom, alternateName: club.sigle,
    url: new URL(url('/'), Astro.site).href, telephone: club.telephone, email: club.email, foundingDate: '1979',
    image: new URL(asset('/partage.jpg'), Astro.site).href, sameAs: [club.facebook],
    address: { '@type': 'PostalAddress', streetAddress: 'Aéroport de Beauvais-Tillé, zone aéroplaisance', postalCode: '60000', addressLocality: 'Tillé', addressCountry: 'FR' },
    geo: { '@type': 'GeoCoordinates', latitude: club.latitude, longitude: club.longitude },
  })} />
  <section class="hero" aria-label="Présentation">
    <div class="slides">
      {slides.map((s, i) => <img {...photo(s.img, '100vw')} fetchpriority={i ? undefined : 'high'} alt={s.legende} class:list={{ on: i === 0 }} loading={i ? 'lazy' : 'eager'} />)}
    </div>
    <div class="voile"></div>
    <svg class="vol" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <mask id="trace-mask" maskUnits="userSpaceOnUse"><path id="trace-plein" d="M -60 560 C 220 560, 430 470, 580 330 S 840 70, 1100 30" fill="none" stroke="#fff" stroke-width="6" /></mask>
      </defs>
      <path class="trace" d="M -60 560 C 220 560, 430 470, 580 330 S 840 70, 1100 30" mask="url(#trace-mask)" />
      <g class="avion-svg"><path transform="scale(1.4)" d="M16,0 C16,-1.6 13,-2.4 10,-2.4 L4,-2.4 L2,-19 L-3,-19 L-3,-2.4 L-14,-2 L-17,-8 L-20,-8 L-19,-1.6 L-19,1.6 L-20,8 L-17,8 L-14,2 L-3,2.4 L-3,19 L2,19 L4,2.4 L10,2.4 C13,2.4 16,1.6 16,0 Z" /></g>
    </svg>
    <div class="container hero-inner">
      <div class="texte">
        <span class="eyebrow" data-reveal data-delay="0.1">Aéroport de Beauvais-Tillé</span>
        <h1 data-split="now">{pg.titre}</h1>
        <p class="lead" data-reveal data-delay="0.8">{pg.texte.replace('{annees}', String(annees))}</p>
      </div>
    </div>
  </section>

  <section class="choix-section" aria-label="Que voulez-vous faire ?">
    <div class="container">
      <h2 class="question">Que voulez-vous faire ?</h2>
      <div class="choix" data-stagger>
        {choix.map((c, i) => (
          <a class:list={['choix-carte', `c-${c.id}`, { secondaire: i === 2 }]} href={url(c.href)}>
            <img {...photo(c.image, '(min-width: 900px) 20vw, 35vw')} alt="" loading={i < 2 ? 'eager' : 'lazy'} />
            <div class="choix-texte">
              {c.badge && <span class="badge">{c.badge}</span>}
              <h3>{c.titre}</h3>
              <p>{c.texte}</p>
              <span class="action">{c.action} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section white vedette">
    <div class="container duo">
      <div class="duo-img" data-reveal="left"><img {...photo(pg.bapteme.image, '(min-width: 900px) 45vw, 100vw')} alt="" loading="lazy" /></div>
      <div class="duo-txt">
        <span class="eyebrow">Baptême de l'air</span>
        <h2 data-split>{pg.bapteme.titre}</h2>
        <p class="lead" data-reveal>{pg.bapteme.texte}</p>
        <ul class="formules" data-stagger>
          {t.formules.map((x) => (
            <li><span><b>{x.titre}</b><small>{x.texte}</small></span><strong>{x.prix.length > 1 && <i>dès</i>}{Math.min(...x.prix.map((p) => p.prix)).toLocaleString('fr-FR')} €</strong></li>
          ))}
        </ul>
        <div class="btns">
          <a class="btn btn-primary" href={url('/contact?objet=Baptême')}>Réserver mon vol</a>
          <a class="btn btn-outline" href={url('/contact?objet=Bon cadeau')}>Offrir un bon cadeau</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section vedette pilote">
    <div class="container duo inverse">
      <div class="duo-img" data-reveal="right"><img {...photo(pg.formation.image, '(min-width: 900px) 45vw, 100vw')} alt="" loading="lazy" /></div>
      <div class="duo-txt">
        <span class="eyebrow">Formation de pilote</span>
        <h2 data-split>{pg.formation.titre}</h2>
        <p class="lead" data-reveal>{pg.formation.texte}</p>
        <ol class="etapes-courtes" data-stagger>
          {f.parcours.slice(0, 4).map((e, i) => <li><span>{i + 1}</span>{e.titre}</li>)}
        </ol>
        <div class="btns">
          <a class="btn btn-primary" href={url('/formations#simulateur')}>Calculer mon budget</a>
          <a class="btn btn-outline" href={url('/formations')}>Comment ça se passe</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section confiance">
    <div class="container">
      <h2 data-split>{pg.atouts_titre}</h2>
      <div class="points" data-stagger>
        {pg.atouts.map((a) => {
          const v = a.chiffre.replace('{avions}', String(avions.length));
          const m = v.match(/^(\d+)\s*(%?)$/);
          return (
            <div>
              <strong {...(m ? { 'data-count': m[1], 'data-suffix': m[2] ? ' %' : undefined, 'data-from': +m[1] > 1000 ? String(+m[1] - 80) : undefined } : {})}>{v}</strong>
              <span>{a.texte}{a.lien && <> <a href={url(a.lien)}>{a.lien_texte || 'En savoir plus'}</a></>}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="bande-metar"><div class="container"><Metar sombre /></div></div>

  <section class="section">
    <div class="container contact-band">
      <div>
        <span class="label">Nous trouver</span>
        <h2 data-split>Passez nous voir au club</h2>
        <p class="lead" data-reveal>Zone aéroplaisance de l'aéroport de Beauvais-Tillé. Adresse, horaires, plan d'accès et itinéraire : tout est dans les infos pratiques.</p>
        <div class="btns" data-stagger>
          <a class="btn btn-primary" href={url('/club#infos')}>Venir au club</a>
          <a class="btn btn-outline" href={`tel:${club.telephone.replace(/\s/g, '')}`}>{club.telephone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  // Avion qui traverse le ciel du hero en laissant une trace pointillée, puis la parallaxe au défilement.
  if (document.documentElement.classList.contains('motion')) {
    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);
    const mm = gsap.matchMedia();
    mm.add('(min-width: 701px)', () => {
      const plein = document.getElementById('trace-plein') as unknown as SVGPathElement;
      const longueur = plein.getTotalLength();
      gsap.set(plein, { strokeDasharray: longueur, strokeDashoffset: longueur });
      gsap.set('.vol', { autoAlpha: 1 });
      gsap.timeline({ delay: 1.2, repeat: -1, repeatDelay: 7 })
        .set('.trace', { opacity: 1 })
        .set(plein, { strokeDashoffset: longueur })
        .to('.avion-svg', { duration: 7, ease: 'power1.inOut', motionPath: { path: '#trace-plein', align: '#trace-plein', alignOrigin: [0.5, 0.5], autoRotate: true } }, 0)
        .to(plein, { strokeDashoffset: 0, duration: 7, ease: 'power1.inOut' }, 0)
        .to('.trace', { opacity: 0, duration: 2, ease: 'power2.in' }, 7.5);

      const scroll = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
      gsap.to('.slides', { yPercent: 18, ease: 'none', scrollTrigger: scroll });
      gsap.to('.vol', { yPercent: 30, ease: 'none', scrollTrigger: scroll });
      gsap.to('.hero .texte', { y: -90, opacity: 0.15, ease: 'none', scrollTrigger: scroll });
    });
  }

  const imgs = [...document.querySelectorAll<HTMLImageElement>('.slides img')];
  const n = document.getElementById('slide-n');
  const l = document.getElementById('slide-l');
  let i = 0;
  if (imgs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      imgs[i].classList.remove('on');
      i = (i + 1) % imgs.length;
      imgs[i].loading = 'eager';
      imgs[i].classList.add('on');
      if (n) n.textContent = String(i + 1).padStart(2, '0');
      if (l) l.textContent = imgs[i].alt;
    }, 6000);
  }
</script>

<style>
  .hero { position: relative; min-height: min(58vh, 520px); display: flex; color: #fff; background: var(--ink); overflow: hidden; }
  .slides { position: absolute; inset: 0; }
  .slides img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity 1.4s ease, transform 7s ease-out; }
  .slides img.on { opacity: 1; transform: scale(1); }
  .voile { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,18,31,.78) 0%, rgba(10,18,31,.35) 55%, rgba(10,18,31,.1) 100%), linear-gradient(0deg, rgba(10,18,31,.7) 0%, transparent 40%); }
  .vol { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; visibility: hidden; }
  .trace { fill: none; stroke: rgba(255,255,255,.7); stroke-width: 2; stroke-dasharray: 2 12; stroke-linecap: round; }
  .avion-svg path { fill: #fff; filter: drop-shadow(0 6px 10px rgba(0,0,0,.35)); }
  @media (max-width: 700px) { .vol { display: none; } }
  .hero-inner { position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(48px, 8vh, 96px) 0 clamp(64px, 9vh, 96px); }
  .hero h1 { font-size: clamp(2.1rem, 5vw, 3.8rem); }
  .hero h1 { color: #fff; max-width: 13ch; }
  .hero .lead { color: rgba(255,255,255,.88); max-width: 46ch; }
  /* Mobile : la photo passe au-dessus, le texte sur fond uni pour rester lisible. */
  @media (max-width: 700px) {
    .hero { flex-direction: column; min-height: 0; }
    .slides { position: relative; height: 38vw; max-height: 240px; overflow: hidden; }
    .voile { inset: 0 0 auto 0; height: min(38vw, 240px); background: linear-gradient(180deg, rgba(10,18,31,0) 55%, var(--ink) 100%); }
    .hero-inner { padding: 0 0 22px; }
    .hero .eyebrow { display: none; }
    .hero h1 { font-size: 1.65rem; margin-bottom: .3em; max-width: 18ch; }
    .hero .lead { font-size: .95rem; margin: 0; line-height: 1.5; }
    .hero .lead { color: rgba(255,255,255,.82); }
    .hero .btns .btn { flex: 1 1 auto; justify-content: center; }
  }




  .facons { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  .facons :global(.carte) { min-height: 0; }
  .facons :global(.carte .img) { aspect-ratio: 3 / 2; flex: none; min-height: 0; }
  @media (max-width: 860px) { .facons { grid-template-columns: 1fr; } .facons :global(.carte) { min-height: 0; } }
  /* Les deux grands choix (baptême / devenir pilote), à cheval sur la photo */
  .choix-section { position: relative; z-index: 2; padding-bottom: clamp(32px, 5vw, 56px); }
  .question { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .choix { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; margin-top: -48px; }
  .choix-carte { --c: var(--sun); position: relative; display: grid; grid-template-columns: 42% 1fr; min-height: 190px; border-radius: 20px; overflow: hidden; background: #fff; border: 1px solid var(--line); text-decoration: none; color: inherit; box-shadow: 0 18px 40px rgba(15,27,45,.12); transition: transform .25s, box-shadow .25s; }
  .choix-carte:hover { transform: translateY(-3px); box-shadow: 0 22px 50px rgba(15,27,45,.18); color: inherit; }
  .c-apprendre { --c: #2f6fd6; } .c-voler { --c: #1f8a70; }
  .choix-carte img { width: 100%; height: 100%; object-fit: cover; }
  .choix-texte { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 18px 20px; border-top: 4px solid var(--c); }
  .choix-texte h3 { font-size: clamp(1.2rem, 2.2vw, 1.55rem); margin: 0; }
  .choix-texte p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.4; }
  .badge { font-size: .75rem; font-weight: 700; letter-spacing: .04em; padding: 3px 10px; border-radius: 999px; background: color-mix(in srgb, var(--c) 14%, white); color: color-mix(in srgb, var(--c) 62%, black); }
  .action { margin-top: auto; padding-top: 8px; font-weight: 600; color: color-mix(in srgb, var(--c) 78%, black); font-size: .95rem; }
  .choix-carte.secondaire { grid-column: 1 / -1; grid-template-columns: 1fr; min-height: 0; box-shadow: none; background: transparent; }
  .secondaire img { display: none; }
  .secondaire .choix-texte { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 14px 20px; border-top: 0; border-left: 4px solid var(--c); }
  .secondaire h3 { font-size: 1.1rem; }
  .secondaire .action { margin: 0 0 0 auto; padding: 0; }
  @media (max-width: 700px) {
    .choix { grid-template-columns: 1fr; margin-top: 12px; gap: 10px; }
    .choix-section { padding-bottom: 28px; }
    .choix-carte { grid-template-columns: 34% 1fr; min-height: 0; box-shadow: 0 8px 22px rgba(15,27,45,.08); }
    .choix-texte { padding: 12px 14px; border-top: 0; border-left: 4px solid var(--c); }
    .choix-texte p { display: none; }
    .choix-texte h3 { font-size: 1.15rem; }
    .choix-carte img { min-height: 104px; }
    .action { padding-top: 4px; font-size: .9rem; }
    .secondaire .choix-texte { padding: 12px 14px; }
    .secondaire p { display: none; }
  }
  .confiance { background: var(--white); }
  .confiance h2 { margin-bottom: 24px; }
  .points { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  .points div { display: flex; flex-direction: column; gap: 6px; padding-top: 14px; border-top: 2px solid var(--line); }
  .points strong { font-family: var(--font-title); font-size: 2.4rem; line-height: 1; color: var(--ink); }
  .points span { color: var(--muted); font-size: .95rem; }
  @media (max-width: 700px) { .points { grid-template-columns: 1fr; gap: 14px; } .points div { flex-direction: row; align-items: baseline; gap: 14px; } .points strong { font-size: 1.8rem; min-width: 3.2em; } }
  .bande-metar { background: #0a1424; border-top: 1px solid rgba(255,255,255,.08); padding: 12px 0; }
  .contact-band { display: block; }
  .contact-band .btns { margin-top: 20px; }

  /* Mises en avant : baptême puis formation, photo d'un côté et l'essentiel de l'autre */
  .duo { display: grid; gap: clamp(24px, 4vw, 56px); grid-template-columns: 1fr 1fr; align-items: center; }
  .duo.inverse .duo-img { order: 2; }
  .duo-img { border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 3; }
  .duo-img img { width: 100%; height: 100%; object-fit: cover; }
  .vedette .eyebrow { color: var(--accent-fonce); }
  .vedette .lead { margin: 0 0 20px; font-size: 1.08rem; }
  .vedette.pilote { --accent: #2f6fd6; --accent-fonce: color-mix(in srgb, var(--accent) 78%, black); }
  .formules { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid var(--line); }
  .formules li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .formules span { display: flex; flex-direction: column; min-width: 0; }
  .formules b { font-family: var(--font-title); font-weight: 600; font-size: 1.08rem; color: var(--ink); }
  .formules small { color: var(--muted); font-size: .86rem; line-height: 1.35; }
  .formules strong { flex: none; font-family: var(--font-title); font-size: 1.5rem; color: var(--accent-fonce); white-space: nowrap; }
  .formules i { font-style: normal; font-family: var(--font-body); font-size: .78rem; font-weight: 500; color: var(--muted); margin-right: 6px; }
  .etapes-courtes { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .etapes-courtes li { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: #fff; border: 1px solid var(--line); font-weight: 600; color: var(--ink); font-size: .95rem; line-height: 1.25; }
  .etapes-courtes span { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 12%, white); color: var(--accent-fonce); font-family: var(--font-title); font-size: .9rem; }
  @media (max-width: 899px) {
    .duo { grid-template-columns: 1fr; }
    .duo.inverse .duo-img { order: 0; }
    .duo-img { aspect-ratio: 16 / 9; border-radius: 18px; }
    .vedette .btns .btn { flex: 1 1 auto; justify-content: center; }
  }
  @media (max-width: 599px) {
    .formules small { display: none; }
    .etapes-courtes { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
