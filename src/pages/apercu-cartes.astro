---
// Page temporaire pour choisir le style des cartes de l'accueil.
import Base from '../layouts/Base.astro';
import UniversCard from '../components/UniversCard.astro';
import { univers } from '../data/univers';
const variantes = [
  { id: 'photo', titre: 'Style 1 · Photo plein cadre', texte: 'La photo occupe toute la carte, le titre est posé sur un dégradé sombre, avec une flèche ronde.' },
  { id: 'bandeau', titre: 'Style 2 · Bandeau de couleur', texte: 'La photo en haut, le titre dans une bande à la couleur de la rubrique.' },
  { id: 'epure', titre: 'Style 3 · Épuré', texte: 'La photo en haut, le texte sur fond blanc dessous, avec un filet de couleur.' },
] as const;
---
<Base title="Aperçu des cartes" noindex>
  {variantes.map((v, i) => (
    <section class:list={['section', { white: i % 2 }]} id={v.id}>
      <div class="container">
        <span class="label"><b>{i + 1}</b> {v.titre}</span>
        <p class="lead">{v.texte}</p>
        <div class="cartes-grid">{univers.map((u, j) => <UniversCard u={u} big={j === 0} variante={v.id} />)}</div>
      </div>
    </section>
  ))}
</Base>
