---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
const actus = (await getCollection('actualites', (a) => a.data.publie)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const annees = [...new Set(actus.map((a) => a.data.date.getFullYear()))];
import pages from '../../data/pages.json';
---
<Base univers="actus" title="Actualités" description="Les actualités de l'aéroclub de Beauvais-Tillé depuis 2006.">
  <PageHead eyebrow="Le club · Actualités" image={pages.actualites.image} title={pages.actualites.titre} lead={pages.actualites.texte} />
  <section class="section">
    <div class="container">
      <div class="filters" data-filter="annee" data-reveal>
        {annees.map((y, i) => <button aria-pressed={i === 0 ? 'true' : 'false'} data-v={String(y)}>{y}</button>)}
        <button aria-pressed="false" data-v="">Toutes les années</button>
      </div>
      <noscript><style>{'.annee-bloc { display: block !important; }'}</style></noscript>
      {annees.map((y, i) => (
        <div class="annee-bloc" data-annee={y} style={i === 0 ? undefined : 'display:none'}>
          <h2 data-reveal>{y}</h2>
          <div class="grid grid-3 grille-actus" data-batch>{actus.filter((a) => a.data.date.getFullYear() === y).map((a) => <NewsCard actu={a} />)}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
<script>
  // Par défaut, seule l'année la plus récente est affichée (la page reste courte) ; les boutons donnent accès aux autres.
  const state: Record<string, string> = { annee: document.querySelector<HTMLElement>('.filters button[aria-pressed="true"]')?.dataset.v ?? '' };
  function apply() {
    document.querySelectorAll<HTMLElement>('.news').forEach((n) => {
      const ok = (!state.annee || n.dataset.annee === state.annee);
      n.style.display = ok ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.annee-bloc').forEach((b) => {
      b.style.display = b.querySelector('.news:not([style*="none"])') ? '' : 'none';
    });
  }
  document.querySelectorAll<HTMLElement>('.filters').forEach((group) => {
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      state[group.dataset.filter!] = btn.dataset.v ?? '';
      apply();
    });
  });
</script>
<style>.annee-bloc { margin-bottom: 48px; } .grille-actus { grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }</style>
