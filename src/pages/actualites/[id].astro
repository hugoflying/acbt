---
import { photo, photoUrl } from '../../lib/photo';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url, asset, dateFr } from '../../lib/utils';
export async function getStaticPaths() {
  const actus = await getCollection('actualites', (a) => a.data.publie);
  return actus.map((a) => ({ params: { id: a.id }, props: { actu: a } }));
}
const { actu } = Astro.props;
const { Content } = await render(actu);
const cover = actu.data.image ?? actu.data.galerie[0];
const galerie = actu.data.galerie.filter((g) => g !== cover);
---
<Base univers="actus" title={actu.data.titre} image={cover} type="article" description={`${actu.data.titre} : une actualité de l'aéroclub de Beauvais-Tillé du ${dateFr(actu.data.date)}.`}>
  <article class="section">
    <div class="container prose">
      <p><a href={url('/actualites')}>← Toutes les actualités</a></p>
      <p class="meta">{dateFr(actu.data.date)}</p>
      <h1 data-split="now">{actu.data.titre}</h1>
      {cover && <img {...photo(cover, '(min-width: 1000px) 960px, 100vw')} alt="" data-clip />}
      <Content />
    </div>
    {galerie.length > 0 && (
      <div class="container" style="margin-top:32px">
        <h2>Photos</h2>
        <div class="gallery" data-batch>{galerie.map((g) => <a href={asset(g)} target="_blank"><img {...photo(g, '(min-width: 700px) 25vw, 50vw')} alt="" loading="lazy" /></a>)}</div>
      </div>
    )}
  </article>
</Base>
