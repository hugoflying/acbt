---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { asset, url } from '../../lib/utils';
const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base univers="voler" title="La flotte" description="Les avions de l'aéroclub de Beauvais-Tillé : Robin DR400, DR300 et Jodel D120.">
  <PageHead eyebrow="Notre flotte" image="/uploads/avions/jodel-d120-02.jpg" title={`${avions.length} avions pour apprendre et voyager`} lead="Des Robin robustes pour l'école et le voyage, et un Jodel à train classique pour se perfectionner." />
  {avions.map((a, i) => (
    <section class={`section ${i % 2 ? 'soft' : ''}`} id={a.id}>
      <div class="container grid grid-2 avion">
        <div>
          {a.data.photos[0] && <div class="main-cadre" data-clip><img class="main" src={asset(a.data.photos[0])} alt={a.data.nom} loading={i ? 'lazy' : 'eager'} data-parallax="3"  /></div>}
          {a.data.photos.length > 1 && (
            <div class="gallery" style="margin-top:10px" data-stagger>
              {a.data.photos.slice(1).map((p) => <a href={asset(p)} target="_blank"><img src={asset(p)} alt="" loading="lazy" /></a>)}
            </div>
          )}
        </div>
        <div data-reveal="right">
          <span class="eyebrow">{a.data.usage}</span>
          <h2 class="immat">{a.data.immatriculation || a.data.nom}</h2>
          <dl>
            <dt>Type</dt><dd>{a.data.type}</dd>
            {a.data.puissance && <><dt>Moteur</dt><dd>{a.data.puissance} ch</dd></>}
            {a.data.places && <><dt>Places</dt><dd>{a.data.places}</dd></>}
          </dl>
          {a.data.description && <p>{a.data.description}</p>}
        </div>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="container" style="text-align:center">
      <h2 data-split>Envie de voler avec nous ?</h2>
      <a class="btn btn-primary" data-reveal="scale" href={url('/club/tarifs')}>Voir les tarifs</a>
    </div>
  </section>
</Base>
<style>
  .avion { align-items: start; }
  .main-cadre { border-radius: var(--radius); overflow: hidden; aspect-ratio: 3 / 2; }
  .main { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; height: 100%; }
  .gallery { grid-template-columns: repeat(3, 1fr); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 0 0 1em; }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 600; }
  .immat { display: table; margin-top: 10px; background: var(--ink); color: #fff; padding: 6px 18px 4px; border-radius: 10px; letter-spacing: .04em; box-shadow: inset 0 0 0 2px rgba(255,255,255,.12); }
</style>
