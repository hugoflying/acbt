---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Etapes from '../components/Etapes.astro';
import Faq from '../components/Faq.astro';
import club from '../data/club.json';
import f from '../data/formations.json';
import pages from '../data/pages.json';
import { url } from '../lib/utils';
const formations = f.licences;
const pg = pages.formations;
---
<Base univers="apprendre" title="Se former" description="Formations BIA, LAPL et PPL à l'aéroclub de Beauvais-Tillé.">
  <PageHead eyebrow="Apprendre" image={pg.image} title={pg.titre} lead={pg.texte} />
  <section class="section">
    <div class="container grid grid-3" data-stagger>
      {formations.map((f) => (
        <div class="card"><div class="card-body">
          <span class="big">{f.nom}</span>
          <h3>{f.titre}</h3>
          <p class="meta">{f.age}</p>
          <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
        </div></div>
      ))}
    </div>
    <div class="container" style="margin-top:28px">
      <p class="meta" data-reveal>{f.note}</p>
    </div>
  </section>
  {f.parcours.length > 0 && (
    <section class="section white">
      <div class="container">
        <span class="eyebrow">Le parcours</span>
        <h2 data-split>{f.parcours_titre}</h2>
        <Etapes etapes={f.parcours} />
      </div>
    </section>
  )}
  <section class="section soft">
    <div class="container">
      <span class="eyebrow">Aides au financement</span>
      <h2 data-split>Voler jeune coûte moins cher</h2>
      <div class="grid grid-3" data-stagger>
        {club.aides.map((a) => <div class="card"><div class="card-body"><h3>{a.titre}</h3><p>{a.texte}</p></div></div>)}
      </div>
      <div class="btns" style="margin-top:32px" data-stagger>
        <a class="btn btn-primary" href={url('/contact?objet=Inscription')}>S'inscrire ou poser une question</a>
        <a class="btn btn-outline" href={url('/club/tarifs')}>Voir les tarifs</a>
      </div>
    </div>
  </section>
  {f.questions.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 data-split>Avant de vous lancer</h2>
        <Faq questions={f.questions} />
      </div>
    </section>
  )}
</Base>
<style>
  .big { font-family: var(--font-title); font-size: 2.4rem; font-weight: 700; color: var(--sun); }
  ul { padding-left: 1.1em; margin: 0; }
  li { margin-bottom: 6px; }
</style>
