---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Etapes from '../components/Etapes.astro';
import Faq from '../components/Faq.astro';
import club from '../data/club.json';
import f from '../data/formations.json';
import pages from '../data/pages.json';
import { url } from '../lib/utils';
const formations = f.licences;
const pg = pages.formations;
---
<Base univers="apprendre" title="Se former" description="Formations BIA, LAPL et PPL à l'aéroclub de Beauvais-Tillé.">
  <PageHead eyebrow="Apprendre" image={pg.image} title={pg.titre} lead={pg.texte} />
  <section class="section">
    <div class="container grid grid-3" data-stagger>
      {formations.map((f) => (
        <div class="card"><div class="card-body">
          <span class="big">{f.nom}</span>
          <h3>{f.titre}</h3>
          <p class="meta">{f.age}</p>
          <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
        </div></div>
      ))}
    </div>
    <div class="container" style="margin-top:28px">
      <p class="meta" data-reveal>{f.note}</p>
    </div>
  </section>
  {f.privileges.length > 0 && (
    <section class="section white" id="privileges">
      <div class="container">
        <span class="eyebrow">LAPL ou PPL</span>
        <h2 data-split>{f.privileges_titre}</h2>
        <div class="compare" data-reveal>
          <div class="ligne entete" aria-hidden="true"><span></span><b>LAPL</b><b>PPL</b></div>
          {f.privileges.map((p) => (
            <div class="ligne">
              <span class="critere">{p.critere}</span>
              <div><span class="tag">LAPL</span><p>{p.lapl}</p></div>
              <div><span class="tag">PPL</span><p>{p.ppl}</p></div>
            </div>
          ))}
        </div>
        <p class="meta" style="margin-top:18px;max-width:80ch" data-reveal>{f.privileges_note}</p>
      </div>
    </section>
  )}
  {f.maintien.length > 0 && (
    <section class="section soft" id="maintien">
      <div class="container">
        <span class="eyebrow">Une fois breveté</span>
        <h2 data-split>{f.maintien_titre}</h2>
        <p class="lead" style="max-width:62ch" data-reveal>{f.maintien_intro}</p>
        <div class="maintien" data-stagger>
          {f.maintien.map((m) => (
            <div class="card"><div class="card-body">
              <span class="pour">{m.pour}</span>
              <h3>{m.titre}</h3>
              <p>{m.texte}</p>
            </div></div>
          ))}
        </div>
        <p class="notice" style="margin-top:24px;max-width:80ch" data-reveal>{f.maintien_note}</p>
      </div>
    </section>
  )}
  {f.parcours.length > 0 && (
    <section class="section white">
      <div class="container">
        <span class="eyebrow">Le parcours</span>
        <h2 data-split>{f.parcours_titre}</h2>
        <Etapes etapes={f.parcours} />
      </div>
    </section>
  )}
  <section class="section soft">
    <div class="container">
      <span class="eyebrow">Aides au financement</span>
      <h2 data-split>Voler jeune coûte moins cher</h2>
      <div class="grid grid-3" data-stagger>
        {club.aides.map((a) => <div class="card"><div class="card-body"><h3>{a.titre}</h3><p>{a.texte}</p></div></div>)}
      </div>
      <div class="btns" style="margin-top:32px" data-stagger>
        <a class="btn btn-primary" href={url('/contact?objet=Inscription')}>S'inscrire ou poser une question</a>
        <a class="btn btn-outline" href={url('/club/tarifs')}>Voir les tarifs</a>
      </div>
    </div>
  </section>
  {f.questions.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 data-split>Avant de vous lancer</h2>
        <Faq questions={f.questions} />
      </div>
    </section>
  )}
</Base>
<style>
  .big { font-family: var(--font-title); font-size: 2.4rem; font-weight: 700; color: var(--sun); }
  ul { padding-left: 1.1em; margin: 0; }
  li { margin-bottom: 6px; }
  .maintien { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .maintien h3 { font-size: 1.15rem; margin: 6px 0 8px; }
  .maintien p { margin: 0; color: var(--muted); font-size: .95rem; }
  .pour { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent, var(--sun)); }
  .compare { border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: #fff; }
  .ligne { display: grid; grid-template-columns: minmax(160px, .8fr) 1fr 1fr; }
  .ligne > * { padding: 14px 20px; border-top: 1px solid var(--line); }
  .ligne > :not(:first-child) { border-left: 1px solid var(--line); }
  .entete > * { border-top: 0; background: var(--ink); color: #fff; font-family: var(--font-title); font-size: 1.25rem; letter-spacing: .02em; }
  .entete > :first-child { background: var(--ink); }
  .critere { font-weight: 600; color: var(--ink); background: var(--paper); }
  .tag { display: none; }
  .ligne p { margin: 0; }
  @media (max-width: 720px) {
    .compare { border: 0; background: none; border-radius: 0; overflow: visible; display: grid; gap: 14px; }
    .ligne.entete { display: none; }
    .ligne { display: block; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
    .ligne > * { border: 0; }
    .ligne > :not(:first-child) { border-left: 0; }
    .critere { display: block; padding: 12px 16px; background: var(--ink); color: #fff; font-family: var(--font-title); font-size: 1.02rem; }
    .ligne > div { display: grid; grid-template-columns: 52px 1fr; gap: 12px; align-items: start; padding: 12px 16px; font-size: .95rem; line-height: 1.5; }
    .ligne > div + div { border-top: 1px solid var(--line); }
    .tag { display: inline-block; text-align: center; font-family: var(--font-title); font-weight: 700; font-size: .74rem; letter-spacing: .06em; padding: 4px 0; border-radius: 8px; background: var(--paper); color: var(--ink); margin-top: 1px; }
    .ligne > div:last-child .tag { background: var(--sun); color: #fff; }
  }
</style>
