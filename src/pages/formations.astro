---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import club from '../data/club.json';
import { url } from '../lib/utils';
const formations = [
  { nom: 'BIA', titre: "Brevet d'initiation aéronautique", age: 'Dès 13 ans', points: ["Cours théoriques au collège, au lycée ou au club", 'Initiation pratique en vol au club', 'Ouvre droit à des bourses pour la suite de la formation'] },
  { nom: 'LAPL', titre: "Licence de pilote d'avion léger", age: 'Examen à 17 ans, solo dès 16 ans', points: ['30 h de vol minimum, dont 15 h en double commande et 6 h en solo supervisé (3 h de navigation)', "Jusqu'à 3 passagers après 10 h de vol comme commandant de bord", 'Valable dans toute l\'Europe (UE, Suisse, Islande, Norvège, Liechtenstein)'] },
  { nom: 'PPL', titre: 'Licence de pilote privé', age: 'Examen à 17 ans', points: ['45 h de vol minimum, dont 25 h en double commande et 10 h en solo supervisé', 'Passagers sans limite de distance, dans le monde entier', 'Ouvre aux qualifications (vol de nuit, vol aux instruments…)'] },
];
---
<Base univers="apprendre" title="Se former" description="Formations BIA, LAPL et PPL à l'aéroclub de Beauvais-Tillé.">
  <PageHead eyebrow="02 · Apprendre" image="/uploads/actualites/2022/lache-elisa/01.jpg" title="Devenez pilote à Beauvais-Tillé" lead="Nos instructeurs bénévoles vous accompagnent du premier vol jusqu'à la licence. Théorie, pratique et examen : tout se prépare au club." />
  <section class="section">
    <div class="container grid grid-3" data-stagger>
      {formations.map((f) => (
        <div class="card"><div class="card-body">
          <span class="big">{f.nom}</span>
          <h3>{f.titre}</h3>
          <p class="meta">{f.age}</p>
          <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
        </div></div>
      ))}
    </div>
    <div class="container" style="margin-top:28px">
      <p class="meta" data-reveal>Pour toutes les licences : réussite aux examens théorique et pratique, et visite médicale auprès d'un médecin agréé. La qualification vol de nuit est possible une fois la licence obtenue.</p>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <span class="eyebrow">Aides au financement</span>
      <h2 data-split>Voler jeune coûte moins cher</h2>
      <div class="grid grid-3" data-stagger>
        {club.aides.map((a) => <div class="card"><div class="card-body"><h3>{a.titre}</h3><p>{a.texte}</p></div></div>)}
      </div>
      <div class="btns" style="margin-top:32px" data-stagger>
        <a class="btn btn-primary" href={url('/contact?objet=Inscription')}>S'inscrire ou poser une question</a>
        <a class="btn btn-outline" href={url('/club/tarifs')}>Voir les tarifs</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .big { font-family: var(--font-title); font-size: 2.4rem; font-weight: 700; color: var(--sun); }
  ul { padding-left: 1.1em; margin: 0; }
  li { margin-bottom: 6px; }
</style>
