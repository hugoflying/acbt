---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DocLien from '../../components/DocLien.astro';
import Metar from '../../components/Metar.astro';
import { getCollection } from 'astro:content';
import { RUBRIQUES_AVION } from '../../content.config';
import outils from '../../data/outils.json';
import membre from '../../data/membre.json';
import club from '../../data/club.json';
import { asset } from '../../lib/utils';

const docs = (await getCollection('documents')).map((d) => d.data)
  .sort((a, b) => a.ordre - b.ordre || a.titre.localeCompare(b.titre, 'fr'));
const parCat = (c: string) => docs.filter((d) => d.categorie === c);
const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const docsAvion = docs.filter((d) => d.categorie === 'Documentation avion');
const PROPRES = ['Manuel de vol', 'Centrage'];
const ordreRub = (d: { rubrique?: string }) => RUBRIQUES_AVION.indexOf((d.rubrique ?? 'Autre') as (typeof RUBRIQUES_AVION)[number]);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim();
const fiches = Object.values(
  avions.reduce<Record<string, { titre: string; avions: { id: string; im: string; photo?: string }[] }>>((acc, a) => {
    const m = modele(a.data.type);
    (acc[m] ??= { titre: m, avions: [] }).avions.push({ id: a.id, im: a.data.immatriculation ?? a.data.nom, photo: a.data.photos[0] });
    return acc;
  }, {}),
).map((g) => {
  const ims = g.avions.map((x) => x.im);
  const propres = g.avions.map((x) => ({ ...x, docs: docsAvion.filter((d) => d.avions.includes(x.im) && PROPRES.includes(d.rubrique ?? '')).sort((p, q) => ordreRub(p) - ordreRub(q)) }));
  const communs = docsAvion.filter((d) => !PROPRES.includes(d.rubrique ?? '') && ims.some((i) => d.avions.includes(i))).sort((p, q) => ordreRub(p) - ordreRub(q));
  return { ...g, ims, propres, communs };
});
const court = (t: string) => t.replace(/ F-[A-Z]{4}/, '');
const autres = ['Sécurité', 'Préparation des vols', 'Météo', 'Formulaires'].map((c) => ({ c, docs: parCat(c) })).filter((x) => x.docs.length);
const host = (l: string) => new URL(l).hostname.replace(/^www\./, '');
import pages from '../../data/pages.json';
import MembreTete from '../../components/MembreTete.astro';
import { url } from '../../lib/utils';
import { fichiersMembre } from '../../lib/membre';
const hors = await fichiersMembre();
const mo = Math.round(hors.taille / 1e6);
const connexion = url('/membre/connexion/');
---
<Base univers="membres" title="Espace membre" description="Espace réservé aux membres de l'aéroclub de Beauvais-Tillé : préparation des vols et documentation." noindex>
  <Fragment slot="head">
    <MembreTete />
    <!-- Pas encore connecté sur cet appareil : direction l'écran de connexion -->
    <script is:inline define:vars={{ connexion }}>
      try { if (!localStorage.getItem('acbt-membre')) location.replace(connexion + '?retour=' + encodeURIComponent(location.pathname + location.hash)); } catch (e) {}
    </script>
  </Fragment>
  <PageHead eyebrow="Espace membre" image={pages.membre.image} title={pages.membre.titre} lead={pages.membre.texte}>
    <div class="btns" style="margin-top:20px">
      <a class="btn btn-primary" href={club.aerogest} rel="noopener">Réserver sur Aerogest</a>
    </div>
  </PageHead>

  <div class="outilbar">
    <div class="container outilbar-in">
      <label class="cherche"><span class="sr">Rechercher un document</span>
        <input type="search" id="q" placeholder="Rechercher un document…" autocomplete="off" />
      </label>
    </div>
  </div>
  <p class="container aucun" id="aucun" hidden>Aucun document ne correspond à votre recherche.</p>

  <section class="section" id="outils" data-bloc>
    <div class="container">
      <div class="appli" data-bloc>
        <div class="hors-ligne" id="hors-ligne" data-fichiers={JSON.stringify(hors.liste)}>
          <span class="pastille" aria-hidden="true">✈</span>
          <div>
            <strong>Documents hors ligne</strong>
            <span data-etat>Chaque document ouvert reste disponible sans réseau.</span>
            <progress hidden></progress>
          </div>
          <button type="button" class="btn btn-outline">Tout télécharger ({mo} Mo)</button>
        </div>
        <div class="appli-actions">
          <button type="button" class="btn btn-outline" id="installer" hidden>📲 Installer l'appli</button>
          <button type="button" class="btn btn-outline" id="deconnexion">Se déconnecter</button>
        </div>
        <p class="aide-ios" id="aide-ios" hidden>Sur iPhone : touchez le bouton <b>Partager</b> (le carré avec une flèche) en bas de Safari, puis <b>Sur l'écran d'accueil</b>.</p>
      </div>
      <div class="section-head"><div><span class="label">Préparer son vol</span><h2>Les outils du pilote</h2></div></div>
      <div class="carte-metar"><Metar /></div>
      <div class="cats-outils">
      {outils.categories.map((c) => (
        <div class="bloc" data-bloc>
          <h3>{c.titre}</h3>
          <div class="grid grille-outils">
            {c.outils.map((o) => (
              <a class="card outil" href={o.lien} target="_blank" rel="noopener" data-q={`${o.nom} ${o.description}`.toLowerCase()}><div class="card-body">
                <div class="outil-tete">
                  <span class:list={['logo-site', { perso: (o as { logo?: string }).logo }]} data-init={o.nom.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').slice(0, 2).toUpperCase()}>
                    <img src={(o as { logo?: string }).logo ? asset((o as { logo?: string }).logo!) : `https://www.google.com/s2/favicons?domain=${host(o.lien)}&sz=128`} alt="" width="40" height="40" loading="lazy" onerror="this.remove()" />
                  </span>
                  <h4>{o.nom} ↗</h4>
                </div>
                <p>{o.description}</p>
              </div></a>
            ))}
          </div>
        </div>
      ))}
      </div>
      {autres.length > 0 && (
        <div class="bloc" data-bloc>
          <h3 class="sous-titre">Mémos et formulaires</h3>
          <div class="cats-outils cats-docs">
            {autres.map((x) => (
              <div data-bloc>
                <h4 class="cat-doc">{x.c}</h4>
                <div class="pile">{x.docs.map((d) => <DocLien doc={d} />)}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section soft" id="avions" data-bloc>
    <div class="container">
      <div class="section-head"><div><span class="label">Nos avions</span><h2>Documentation avion</h2></div></div>
      <p class="alerte"><b>!</b><span>{membre.avertissement_avion}</span></p>
      <div class="fiches">
        {fiches.map((g) => (
          <article class="fiche" id={`doc-${g.avions[0].id}`} data-bloc>
            <header>
              <div class="photos">{g.avions.map((x) => x.photo && <img src={asset(x.photo)} alt="" loading="lazy" />)}</div>
              <div><h3>{g.titre}</h3><div class="chips">{g.ims.map((i) => <span>{i}</span>)}</div></div>
            </header>
            <div class="propres" style={`--n:${g.avions.length}`} data-bloc>
              {g.propres.map((x) => (
                <div id={`doc-${x.id}`} data-bloc><h5>{x.im}</h5>{x.docs.map((d) => <DocLien doc={d} court={court(d.titre)} />)}</div>
              ))}
            </div>
            {g.communs.length > 0 && <h5 class="sep">{g.avions.length > 1 ? `Communs aux ${g.avions.length} avions` : 'Équipements et check-list'}</h5>}
            <div class="liste" data-bloc>{g.communs.map((d) => <DocLien doc={d} court={court(d.titre)} />)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="club" data-bloc>
    <div class="container cols2">
      <div><span class="label">Vie du club</span><h2>Les documents de l'association</h2>
        <p class="lead">Livret d'accueil, règlement, statuts et lettres d'information.</p>
        <div class="liens">
          <a class="btn btn-outline" href={club.aerogest} rel="noopener">Aerogest</a>
          {membre.liens_club.filter((l) => l.lien).map((l) => <a class="btn btn-outline" href={l.lien} rel="noopener">{l.libelle}</a>)}
        </div>
      </div>
      <div class="docs" data-bloc>{parCat('Vie du club').map((d) => <DocLien doc={d} />)}</div>
    </div>
  </section>

  <section class="section soft" id="pilote" data-bloc>
    <div class="container">
      <div class="section-head"><div><span class="label">Documentation pilote</span><h2>Terrain, espace aérien et réglementation</h2></div></div>
      <div class="docs docs-2" data-bloc>{parCat('Documentation pilote').map((d) => <DocLien doc={d} />)}</div>
    </div>
  </section>

  <section class="section" id="eleves" data-bloc>
    <div class="container">
      <div class="section-head"><div><span class="label">Parcours élève</span><h2>De la première leçon à la licence</h2></div></div>
      <ol class="parcours">
        {membre.parcours.map((e, i) => {
          const liste = e.categorie_docs ? parCat(e.categorie_docs) : [];
          const liens = e.liens.filter((l) => l.lien);
          return (
            <li class="etape" data-bloc>
              <span class="num">{i + 1}</span>
              <div>
                <h3>{e.titre}</h3>
                <p>{e.texte}</p>
                {liste.length > 0 && <div class="docs">{liste.map((d) => <DocLien doc={d} />)}</div>}
                {liens.length > 0 && <div class="liens">{liens.map((l) => <a class="btn btn-outline" href={l.lien} target="_blank" rel="noopener">{l.libelle} ↗</a>)}</div>}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Base>

<script>
  import { enregistrer, horsLigne, boutonInstaller, seDeconnecter } from '../../scripts/membre-app';
  enregistrer();
  horsLigne(document.getElementById('hors-ligne'));
  boutonInstaller(document.getElementById('installer') as HTMLButtonElement, document.getElementById('aide-ios'));
  document.getElementById('deconnexion')?.addEventListener('click', () => {
    if (confirm('Se déconnecter de l\'espace membre sur cet appareil ? Les documents gardés hors ligne seront effacés.')) seDeconnecter();
  });

  const q = document.getElementById('q') as HTMLInputElement | null;
  const aucun = document.getElementById('aucun');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  q?.addEventListener('input', () => {
    const v = norm(q.value.trim());
    document.querySelectorAll<HTMLElement>('[data-q]').forEach((el) => { el.hidden = !!v && !norm(el.dataset.q || '').includes(v); });
    [...document.querySelectorAll<HTMLElement>('[data-bloc]')].reverse().forEach((b) => {
      b.hidden = !!v && !b.querySelector('[data-q]:not([hidden])');
    });
    if (aucun) aucun.hidden = !v || !!document.querySelector('[data-q]:not([hidden])');
  });
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .outilbar { position: sticky; top: 76px; z-index: 20; transition: top .5s cubic-bezier(.2,.7,.2,1); background: rgba(246,242,234,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .outilbar-in { padding-top: 10px; padding-bottom: 10px; }
  :global(body:has(.site-header.cache)) .outilbar { top: 0; }
  .cherche { display: block; width: 100%; }
  .cherche input { width: 100%; max-width: 520px; display: block; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font: inherit; font-size: .92rem; }
  .cherche input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  @media (max-width: 860px) { .cherche input { max-width: none; } }
  .aucun { padding-top: 32px; color: var(--muted); }
  [hidden] { display: none !important; }
  .appli { display: grid; gap: 12px 16px; grid-template-columns: 1fr auto; align-items: center; margin-bottom: 32px; }
  @media (max-width: 760px) { .appli { grid-template-columns: 1fr; } }
  .hors-ligne { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--accent) 6%, white); }
  .hors-ligne > div { flex: 1 1 220px; display: grid; gap: 2px; font-size: .92rem; color: var(--muted); }
  .hors-ligne strong { color: var(--ink); font-size: 1rem; }
  .hors-ligne progress { width: 100%; height: 8px; accent-color: var(--accent); }
  .hors-ligne .btn, .appli-actions .btn { padding: 9px 16px; font-size: .9rem; }
  .pastille { flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 1.1rem; }
  .appli-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .aide-ios { grid-column: 1 / -1; font-size: .9rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin: 0; }
  .carte-metar { margin-bottom: 28px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: #fff; }

  .bloc { margin-bottom: 36px; }
  .bloc:last-child { margin-bottom: 0; }
  .bloc h3 { font-size: 1.15rem; margin-bottom: 14px; }
  .cats-outils { display: grid; gap: 0 20px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); margin-bottom: 12px; }
  .grille-outils { grid-template-columns: 1fr; gap: 14px; }
  .outil { min-height: 170px; }
  .sous-titre { font-size: 1.3rem; margin: 20px 0 18px; padding-top: 28px; border-top: 1px solid var(--line); }
  .cat-doc { font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; font-family: var(--font-body); }
  .pile { display: grid; gap: 10px; }
  .pile :global(.doc) { min-height: 102px; }
  .cats-docs { gap: 20px; }
  .outil .card-body { height: 100%; box-sizing: border-box; }
  .outil p { margin: 0; }
  .outil { text-decoration: none; color: inherit; }
  .outil h4 { font-size: 1.05rem; margin: 0; }
  .outil-tete { display: flex; align-items: center; gap: 14px; min-height: 52px; margin-bottom: 14px; }
  .logo-site { position: relative; flex: none; width: 96px; height: 48px; border-radius: 12px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; overflow: hidden; }
  .logo-site::before { content: attr(data-init); font-family: var(--font-title); font-weight: 700; font-size: .95rem; color: var(--accent); }
  .logo-site.perso img { width: calc(100% - 16px); height: 34px; }
  .logo-site img { position: absolute; inset: 0; margin: auto; width: 32px; height: 32px; object-fit: contain; background: #fff; }
  .outil:hover h4 { color: var(--accent); }
  .outil p { font-size: .92rem; color: var(--muted); }
  .docs { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .docs-2 { grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
  @media (max-width: 420px) { .docs, .docs-2 { grid-template-columns: 1fr; } }

  .alerte { display: flex; gap: 14px; align-items: flex-start; background: #fff4e5; border: 1px solid #f2c98a; color: #6b4200; border-radius: 14px; padding: 14px 18px; margin-bottom: 28px; font-size: .95rem; }
  .alerte b { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #d9480f; color: #fff; display: grid; place-items: center; font-size: .9rem; }
  .fiches { display: grid; gap: 20px; grid-template-columns: 1.4fr 1fr 1fr; align-items: start; }
  @media (max-width: 1000px) { .fiches { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .fiches { grid-template-columns: 1fr; } }
  .fiche { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 16px; scroll-margin-top: 150px; }
  .fiche header { display: flex; gap: 14px; align-items: center; margin-bottom: 14px; }
  .fiche .photos { display: flex; flex: none; }
  .fiche .photos img { width: 64px; height: 48px; object-fit: cover; border-radius: 10px; border: 2px solid #fff; }
  .fiche .photos img + img { margin-left: -16px; }
  .fiche h3 { margin: 0 0 4px; font-size: 1.25rem; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chips span { font-size: .75rem; font-weight: 600; letter-spacing: .05em; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--ink); }
  .fiche h5 { font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; font-family: var(--font-body); }
  .propres { display: grid; gap: 10px; grid-template-columns: repeat(var(--n), 1fr); padding: 12px; background: color-mix(in srgb, var(--accent) 7%, white); border-radius: 12px; }
  @media (max-width: 420px) { .propres { grid-template-columns: 1fr; } }
  .propres > div { display: grid; gap: 6px; align-content: start; scroll-margin-top: 150px; }
  .fiche .sep { margin-top: 16px; }
  .liste { display: grid; gap: 6px; }
  .fiche :global(.doc) { padding: 7px 10px; }
  .fiche :global(.doc .meta) { display: none; }

  .cols2 { display: grid; gap: 40px; grid-template-columns: 1fr 1.4fr; align-items: start; }
  @media (max-width: 860px) { .cols2 { grid-template-columns: 1fr; } }
  .liens { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }

  .parcours { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; counter-reset: e; }
  .etape { display: grid; grid-template-columns: 56px 1fr; gap: 20px; padding: 26px 0; border-top: 1px solid var(--line); }
  .etape .num { width: 48px; height: 48px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-family: var(--font-title); font-size: 1.4rem; }
  .etape h3 { font-size: 1.3rem; margin: 6px 0 8px; }
  .etape p { color: var(--muted); max-width: 70ch; }
  .etape .docs { margin-top: 14px; }
</style>
