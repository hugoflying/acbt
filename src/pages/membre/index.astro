---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import outils from '../../data/outils.json';
import club from '../../data/club.json';
import { asset, dateFr } from '../../lib/utils';
const docs = (await getCollection('documents')).sort((a, b) => a.data.titre.localeCompare(b.data.titre, 'fr'));
const cats = [...new Set(docs.map((d) => d.data.categorie))];
const host = (l: string) => new URL(l).hostname.replace(/^www\./, '');
---
<Base univers="membres" title="Espace membre" noindex>
  <PageHead eyebrow="05 · Espace membre" image="/uploads/avions/dr400-120-01.jpg" title="Préparer son vol" lead="Météo, NOTAM, cartes et documents du club, réunis au même endroit.">
    <div class="btns" style="margin-top:20px">
      <a class="btn btn-primary" href={club.aerogest} rel="noopener">Réserver un avion sur Aerogest</a>
      <a class="btn btn-ghost" href="#documents">Documents du club</a>
    </div>
  </PageHead>
  <section class="section">
    <div class="container">
      <p class="notice" style="margin-bottom:32px">Maquette : cette page est encore publique. La connexion des membres sera activée lors du passage sur Cloudflare (accès par code reçu par e-mail).</p>
      {outils.categories.map((c) => (
        <div class="bloc">
          <h2>{c.titre}</h2>
          <div class="grid grid-3">
            {c.outils.map((o) => (
              <a class="card outil" href={o.lien} target="_blank" rel="noopener"><div class="card-body">
                <h3>{o.nom} ↗</h3><p>{o.description}</p><span class="meta">{host(o.lien)}</span>
              </div></a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section soft" id="documents">
    <div class="container">
      <h2>Documents du club</h2>
      {cats.map((c) => (
        <div class="bloc">
          <h3>{c}</h3>
          <ul class="docs">
            {docs.filter((d) => d.data.categorie === c).map((d) => (
              <li><a href={asset(d.data.fichier)} target="_blank" rel="noopener"><span class="pdf">PDF</span><span><strong>{d.data.titre}</strong>{d.data.description && <span class="meta">{d.data.description}</span>}{d.data.mis_a_jour && <span class="meta">Mis à jour le {dateFr(d.data.mis_a_jour)}</span>}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .bloc { margin-bottom: 40px; }
  .outil { text-decoration: none; color: inherit; }
  .outil:hover h3 { color: var(--sky); }
  .outil h3 { font-size: 1.05rem; }
  .outil p { font-size: .93rem; color: var(--muted); }
  .docs { list-style: none; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .docs a { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; text-decoration: none; color: inherit; }
  .docs a:hover { border-color: var(--sky); }
  .docs .meta { display: block; }
  .pdf { background: #d64545; color: #fff; font-weight: 700; font-size: .75rem; padding: 6px 8px; border-radius: 6px; }
</style>
