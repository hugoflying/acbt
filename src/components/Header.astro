---
import { url } from '../lib/utils';
const nav = [
  { label: 'Accueil', href: '/', u: '' },
  { label: 'Découvrir', href: '/decouvrir-le-vol', u: 'decouvrir' },
  { label: 'Apprendre', href: '/formations', u: 'apprendre' },
  { label: 'La flotte', href: '/club/flotte', u: 'voler' },
  { label: 'Tarifs', href: '/club/tarifs', u: 'voler' },
  { label: 'Le club', href: '/club', u: 'club' },
  { label: 'Contact', href: '/contact', u: '' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
// « Le club » regroupe aussi l'histoire et les actualités (la flotte et les tarifs ont leur propre onglet)
const actif = (href: string) =>
  href === '/' ? path === url('/').replace(/\/$/, '') || path === '' :
  href === '/club' ? [url('/club'), url('/club/historique'), url('/actualites')].some((p) => path === p || path.startsWith(p + '/')) : path.startsWith(url(href));
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')}>
      <img src={url('/uploads/logo/logo-acbt.png')} alt="" width="72" height="52" />
      <span><strong>ACBT</strong><small>Aéroclub de Beauvais-Tillé</small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Ouvrir le menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav aria-label="Navigation principale">
      <ul>
        {nav.map((n) => (
          <li><a href={url(n.href)} data-u={n.u} aria-current={actif(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li><a class="btn member" href={url('/membre')}>Espace membre</a></li>
      </ul>
    </nav>
  </div>
  <div class="progression" aria-hidden="true"></div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(246,242,234,.9); backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); transition: transform .5s cubic-bezier(.2,.7,.2,1), box-shadow .3s; }
  .site-header.cache { transform: translateY(-100%); }
  .site-header.defile { box-shadow: 0 8px 30px rgba(15,27,45,.08); }
  .progression { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; pointer-events: none; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .logo img { height: 52px; width: auto; display: block; }
  .logo span { display: flex; flex-direction: column; line-height: 1.1; }
  .logo strong { font-family: var(--font-title); font-size: 1.4rem; letter-spacing: .02em; }
  .logo small { font-size: .72rem; color: var(--muted); letter-spacing: .03em; }
  nav ul { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a { display: flex; align-items: center; gap: 8px; padding: 8px 12px; color: var(--text); text-decoration: none; font-weight: 500; font-size: .94rem; border-radius: 999px; white-space: nowrap; }
  nav a[data-u]:not([data-u=''])::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--c); opacity: 0; transition: opacity .2s; }
  nav a:hover::before, nav a[aria-current]::before { opacity: 1 !important; }
  nav a[aria-current] { font-weight: 600; color: var(--ink); }
  a[data-u='decouvrir'] { --c: #e8703a; } a[data-u='apprendre'] { --c: #2f6fd6; } a[data-u='voler'] { --c: #1f8a70; }
  a[data-u='club'] { --c: #b0873a; } a[data-u='actus'] { --c: #c2414b; }
  nav a.member { background: var(--ink); color: #fff; padding: 10px 20px; margin-left: 10px; }
  nav a.member:hover { background: #6b4fbb; color: #fff; }
  .nav-toggle, .burger { display: none; }
  @media (max-width: 1180px) {
    .burger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 10px; }
    .burger span { width: 24px; height: 2px; background: var(--ink); }
    nav { position: absolute; top: 76px; left: 0; right: 0; background: var(--paper); border-bottom: 1px solid var(--line); display: none; }
    nav ul { flex-direction: column; align-items: stretch; padding: 12px 16px 20px; }
    nav a { padding: 12px; font-size: 1.05rem; }
    nav a::before { opacity: 1 !important; }
    nav a.member { margin: 10px 0 0; justify-content: center; }
    .nav-toggle:checked ~ nav { display: block; }
  }
</style>
