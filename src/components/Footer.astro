---
// Pied de page compact : l'essentiel pour un visiteur (nous joindre, les pages principales), le reste en petit.
import club from '../data/club.json';
import { url } from '../lib/utils';
const liens = [
  { label: "Baptême de l'air", href: '/decouvrir-le-vol' },
  { label: 'Devenir pilote', href: '/formations' },
  { label: 'Tarifs', href: '/club/tarifs' },
  { label: 'La flotte', href: '/club/flotte' },
  { label: 'Le club', href: '/club' },
  { label: 'Actualités', href: '/actualites' },
  { label: 'Contact', href: '/contact' },
];
---
<footer class="site-footer">
  <div class="container haut">
    <div class="ident">
      <img class="logo-pied" src={url('/uploads/logo/logo-acbt.jpg')} alt="" width="58" height="42" loading="lazy" />
      <div>
        <strong>{club.nom}</strong>
        <span>{club.adresse}</span>
      </div>
    </div>
    <div class="joindre">
      <a href={`tel:${club.telephone.replace(/\s/g, '')}`}>{club.telephone}</a>
      <a href={`mailto:${club.email}`}>{club.email}</a>
    </div>
  </div>
  <nav class="container liens" aria-label="Plan du site">
    {liens.map((l) => <a href={url(l.href)}>{l.label}</a>)}
    <a href={club.facebook} rel="noopener">Facebook</a>
    <a href={url('/membre')}>Espace membre</a>
  </nav>
  {club.partenaires.length > 0 && (
    <p class="container partenaires">Nos partenaires : {club.partenaires.map((p, i) => <>{i > 0 && ' · '}<a href={p.lien} rel="noopener">{p.nom}</a></>)}</p>
  )}
  <div class="container legal">
    <span>© {new Date().getFullYear()} {club.sigle || 'ACBT'} · association loi 1901 depuis 1979</span>
    <nav aria-label="Informations légales">
      <a href={url('/mentions-legales')}>Mentions légales</a>
      <a href={url('/mentions-legales#donnees')}>Données personnelles</a>
      <a href={url('/mentions-legales#cookies')}>Cookies</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { background: #0a1422; color: #9fb0c6; padding: 28px 0 18px; font-size: .9rem; }
  a { color: #dce6f2; text-decoration: none; }
  a:hover { color: var(--sun); }
  .haut { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px 28px; }
  .ident { display: flex; align-items: center; gap: 14px; }
  .ident div { display: flex; flex-direction: column; line-height: 1.35; }
  .ident strong { color: #fff; font-family: var(--font-title); font-weight: 600; font-size: 1.02rem; }
  .logo-pied { background: #fff; border-radius: 10px; padding: 4px 6px; width: 58px; height: auto; flex: none; }
  .joindre { display: flex; flex-wrap: wrap; gap: 6px 20px; font-weight: 600; }
  .liens { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 18px; padding-top: 16px; border-top: 1px solid #1f2d42; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 14px; font-size: .8rem; }
  .legal nav { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .legal a, .partenaires a { color: #9fb0c6; }
  .partenaires { margin: 14px auto 0; font-size: .8rem; }
</style>
