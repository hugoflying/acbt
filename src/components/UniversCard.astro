---
import { photo, photoUrl } from '../lib/photo';
// Carte d'entrée de l'accueil. Trois styles possibles : 'photo' (plein cadre), 'bandeau' (titre sur bande de couleur), 'epure' (photo + texte dessous).
import { url, asset } from '../lib/utils';
interface Props { u: { id: string; titre: string; sousTitre: string; href: string; image: string }; big?: boolean; variante?: 'photo' | 'bandeau' | 'epure' }
const { u, big = false, variante = 'photo' } = Astro.props;
---
<a class:list={['carte', variante, `u-${u.id}`, { big }]} href={url(u.href)}>
  <div class="img"><div class="par" data-parallax="3"><img {...photo(u.image, '(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw')} alt="" loading="lazy" /></div></div>
  <div class="texte">
    <h3>{u.titre}</h3>
    <p>{u.sousTitre}</p>
  </div>
  <span class="fleche" aria-hidden="true">→</span>
</a>
<style>
  .carte { --c: var(--ink); position: relative; display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; text-decoration: none; color: inherit; isolation: isolate; min-height: 300px; }
  .u-decouvrir { --c: #e8703a; } .u-apprendre { --c: #2f6fd6; } .u-voler { --c: #1f8a70; } .u-club { --c: #b0873a; } .u-membres { --c: #6b4fbb; }
  .big { min-height: 100%; }
  .img { overflow: hidden; }
  .par { width: 100%; height: 100%; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .carte:hover img { transform: scale(1.05); }
  h3 { margin: 0 0 4px; }
  p { margin: 0; }
  .fleche { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; font-size: 1.2rem; transition: transform .25s, background .25s; }
  .carte:hover .fleche { transform: translateX(4px); }

  /* 1. Photo plein cadre : titre sur dégradé, flèche ronde */
  .photo { color: #fff; }
  .photo .img { position: absolute; inset: 0; z-index: -2; }
  .photo::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 30%, rgba(10,18,31,.9) 100%); }
  .photo .texte { margin-top: auto; padding: 26px 90px 26px 26px; }
  .photo h3 { color: #fff; font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .photo.big h3 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .photo p { color: rgba(255,255,255,.85); }
  .photo .fleche { position: absolute; right: 24px; bottom: 26px; background: #fff; color: var(--ink); }
  .photo:hover .fleche { background: var(--c); color: #fff; }

  /* 2. Bandeau couleur : photo, titre dans une bande à la couleur de la rubrique */
  .bandeau { background: var(--c); color: #fff; }
  .bandeau .img { flex: 1; min-height: 200px; }
  .bandeau .texte { padding: 22px 80px 24px 24px; }
  .bandeau h3 { color: #fff; font-size: 1.6rem; }
  .bandeau.big h3 { font-size: 2.2rem; }
  .bandeau p { color: rgba(255,255,255,.88); font-size: .95rem; }
  .bandeau .fleche { position: absolute; right: 20px; bottom: 26px; border: 1.5px solid rgba(255,255,255,.7); color: #fff; }
  .bandeau:hover .fleche { background: #fff; color: var(--c); }

  /* 3. Épuré : photo arrondie, texte sur fond clair dessous, filet de couleur */
  .epure { background: var(--white); border: 1px solid var(--line); }
  .epure .img { flex: 1; min-height: 190px; }
  .epure .texte { padding: 22px 80px 24px 24px; border-top: 4px solid var(--c); }
  .epure h3 { font-size: 1.55rem; }
  .epure.big h3 { font-size: 2.1rem; }
  .epure p { color: var(--muted); font-size: .95rem; }
  .epure .fleche { position: absolute; right: 20px; bottom: 26px; background: var(--paper); color: var(--ink); }
  .epure:hover .fleche { background: var(--c); color: #fff; }
</style>
